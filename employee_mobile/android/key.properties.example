# Copy to android/key.properties and fill in. NEVER commit the real file.
# Create the keystore first (see employee_mobile/RELEASE.md):
#   keytool -genkey -v -keystore bvn-release.jks -keyalg RSA -keysize 2048 \
#           -validity 10000 -alias bvn
storePassword=changeme
keyPassword=changeme
keyAlias=bvn
# Absolute path, or relative to employee_mobile/android/
storeFile=../bvn-release.jks
